# ── Порты на хосте (оба только 127.0.0.1) ───────────────────
# Системный nginx сервера проксирует сайт на FRONTEND_PORT.
# 5000/5001 заняты trend-trade-front, 8001 — trend-trade-back.
FRONTEND_PORT=5002
BACKEND_PORT=8002

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=reputo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reputo

# ── Telegram-бот (уведомления о заявках) ────────────────────
# Токен бота от @BotFather и chat_id, куда слать уведомления.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прокси для Telegram API ─────────────────────────────────
# Ссылка, логин и пароль — тремя отдельными переменными.
# PROXY_URL: http://host:port или socks5://host:port
PROXY_URL=
PROXY_LOGIN=
PROXY_PASSWORD=

# ── CORS (нужен только при разработке фронта без nginx) ─────
CORS_ORIGINS=http://localhost:5173
