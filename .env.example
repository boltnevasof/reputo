# ── Домен и порты ───────────────────────────────────────────
# На сервере 80/443 занимает системный nginx, 5000/5001 — trend-trade-front,
# 8001 — trend-trade-back. Поэтому дефолты reputo — 8080/8443.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=reputo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reputo

# ── Telegram-бот (уведомления о заявках) ────────────────────
# Токен бота от @BotFather и chat_id, куда слать уведомления.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прокси для Telegram API ─────────────────────────────────
# Ссылка, логин и пароль — тремя отдельными переменными.
# PROXY_URL: http://host:port или socks5://host:port
PROXY_URL=
PROXY_LOGIN=
PROXY_PASSWORD=

# ── CORS (нужен только при разработке фронта без nginx) ─────
CORS_ORIGINS=http://localhost:5173
