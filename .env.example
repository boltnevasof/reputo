# ── Порт API на хосте ───────────────────────────────────────
# Системный nginx сервера проксирует /api на этот порт (127.0.0.1).
# 8001 занят trend-trade-back, поэтому 8002.
BACKEND_PORT=8002

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=reputo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reputo

# ── Telegram-бот (уведомления о заявках) ────────────────────
# Токен бота от @BotFather и chat_id, куда слать уведомления.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прокси для Telegram API ─────────────────────────────────
# Ссылка, логин и пароль — тремя отдельными переменными.
# PROXY_URL: http://host:port или socks5://host:port
PROXY_URL=
PROXY_LOGIN=
PROXY_PASSWORD=

# ── CORS (нужен только при разработке фронта без nginx) ─────
CORS_ORIGINS=http://localhost:5173
