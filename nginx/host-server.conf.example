# Конфиг для СИСТЕМНОГО nginx на сервере, где 80/443 уже заняты
# (рядом живёт trend-trade: / → :5000, /api → :8001).
#
# Reputo-контейнер слушает 127.0.0.1:8080, системный nginx терминирует SSL
# и проксирует к нему — та же схема, что у trend-trade в reverse_proxy.conf.
#
# Установка:
#   1. Замените reputo.example.ru на реальный домен (3 места).
#   2. Положите файл в /etc/nginx/sites-available/reputo.conf,
#      симлинк в /etc/nginx/sites-enabled/.
#   3. Выпустите сертификат системным certbot-ом:
#        sudo certbot --nginx -d reputo.example.ru
#      (или certonly --webroot -w /var/www/html, если привыкли так)
#   4. sudo nginx -t && sudo systemctl reload nginx
#
# При этой схеме контейнерный certbot и nginx/ssl.conf.template НЕ нужны —
# они для отдельного сервера, где 80/443 свободны.

server {
    listen 80;
    listen [::]:80;
    server_name reputo.example.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name reputo.example.ru;

    ssl_certificate     /etc/letsencrypt/live/reputo.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reputo.example.ru/privkey.pem;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
